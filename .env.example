VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Opcional — habilita notificaciones push web.
# Generá las VAPID keys con: npx web-push generate-vapid-keys
# Pegá la public key acá y la private key como secret en Supabase
# (supabase secrets set VAPID_PRIVATE_KEY=... VAPID_SUBJECT=mailto:tu@email.com).
VITE_VAPID_PUBLIC_KEY=
